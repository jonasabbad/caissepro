// CaissePro data model.
// Money is Decimal(12,2) and serialised as "12.50" strings (same wire format as the reference app).
// JSON-ish columns are stored as TEXT and (de)serialised in src/lib/json.ts (SQLite has no JSON type).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ─────────────────────────────────────────────────────────────────

model Tenant {
  id                    String    @id @default(uuid())
  name                  String
  slug                  String    @unique
  activityType          String    @default("phone_seller")
  status                String    @default("active") // active | suspended | expired (no trial period)
  plan                  String    @default("") // "" | demarrage | professionnel | multi_magasins | lifetime
  subscriptionExpiresAt DateTime?
  enabledModules        String    @default("[\"core\"]") @db.Text // JSON string[]
  customPricing         String?   @db.Text // JSON {discountPercent, monthlyPrice?, yearlyPrice?}
  autoRenew             Boolean   @default(false)
  city                  String?
  latitude              Float?
  longitude             Float?
  applyTva              Boolean   @default(false)
  legalStatus           String? // auto_entrepreneur | sarl | ...
  settings              String    @default("{}") @db.Text // JSON: locale, taxRate, currency, timezone, lowStockThreshold, defaultPaymentMethods
  businessInfo          String    @default("{}") @db.Text // JSON: legalName, ice, rc, if, patente, cnss, address, city, phone, email
  printing              String    @default("{}") @db.Text // JSON printing preferences
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  stores    Store[]
  users     User[]
  products  Product[]
  customers Customer[]
  suppliers Supplier[]
  soldUnits SoldUnit[]
  employees Employee[]
  repairers Repairer[]
}

model Store {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  code          String
  address       String?  @db.Text
  city          String?
  phone         String?
  isActive      Boolean  @default(true)
  isMain        Boolean  @default(false)
  caisseBalance Decimal  @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  caisseMovements CaisseMovement[]

  @@index([tenantId])
}

model User {
  id                         String    @id @default(uuid())
  tenantId                   String?
  tenant                     Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                      String    @unique
  passwordHash               String
  firstName                  String    @default("")
  lastName                   String    @default("")
  roles                      String    @default("[\"admin\"]") @db.Text // JSON: super_admin | admin | manager | cashier | viewer
  isActive                   Boolean   @default(true)
  currentStoreId             String?
  lastLoginAt                DateTime?
  accountDeletionRequestedAt DateTime?
  sellerMode                 Boolean   @default(false)
  locale                     String? // fr | en | ar — interface language chosen by this user
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@index([tenantId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// ─── Catalogue & stock ───────────────────────────────────────────────────────

model Category {
  id           String   @id @default(uuid())
  tenantId     String? // null = built-in category shared by every business of the activity
  activityType String
  name         String
  slug         String
  parentId     String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@unique([activityType, slug])
  @@index([tenantId])
}

model Product {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId         String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  sku             String
  barcode         String?
  name            String
  description     String?   @db.Text
  costPrice       Decimal   @default(0)
  retailPrice     Decimal   @default(0)
  stockQuantity   Int       @default(0)
  minStockLevel   Int       @default(5)
  packSize        Int?
  packCostPrice   Decimal?
  packRetailPrice Decimal?
  status          String    @default("available") // available | low_stock | out_of_stock | archived
  variants        String?   @db.Text // JSON object
  imageUrl        String?   @db.Text
  isTracked       Boolean   @default(true)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  movements InventoryMovement[]

  @@unique([tenantId, barcode]) // one product per barcode within a business
  @@index([tenantId])
  @@index([tenantId, barcode])
}

model InventoryMovement {
  id               String   @id @default(uuid())
  tenantId         String
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId          String?
  type             String // purchase | sale | return | adjustment | damage | loss | transfer_in | transfer_out | initial
  quantity         Int
  previousQuantity Int
  newQuantity      Int
  reference        String?
  notes            String?  @db.Text
  createdBy        String?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([productId])
}

// ─── Phones (serialised units) ───────────────────────────────────────────────

model SoldUnit {
  id                       String    @id @default(uuid())
  ref                      String // 8-char code printed on labels / encoded in QR when there is no IMEI
  tenantId                 String
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId                  String?
  productId                String?
  supplierOrderId          String?
  supplierId               String?
  transactionId            String?
  customerId               String?
  deviceType               String    @default("phone") // phone | tablet | laptop | macbook | watch
  brand                    String
  model                    String
  imei                     String?
  serialNumber             String?
  storage                  String?
  ram                      String?
  color                    String?
  condition                String    @default("new") // new | new_no_box | grade_a_plus | grade_a | grade_b | grade_c
  purchasePrice            Decimal   @default(0)
  salePrice                Decimal   @default(0)
  profit                   Decimal   @default(0) // salePrice − purchasePrice − repairCost
  repairCost               Decimal   @default(0)
  batteryHealth            Int?
  chargeCycles             Int?
  notes                    String?   @db.Text
  accessories              String?   @db.Text // JSON string[]
  imageUrl                 String?   @db.Text // photo of this device (uploaded), shown in lists and on its page
  hasWarranty              Boolean   @default(true)
  warrantyDays             Int?
  warrantyExpiresAt        DateTime?
  soldAt                   DateTime?
  returnedAt               DateTime?
  reservedAt               DateTime?
  reservationExpiresAt     DateTime?
  reservedByCustomerId     String?
  reservationDeposit       Decimal?
  reservationTransactionId String?
  tradeInAt                DateTime?
  tradeInFromCustomerId    String?
  tradeInValue             Decimal?
  tradeInTransactionId     String?
  createdBy                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([tenantId, soldAt])
  @@index([tenantId, imei])
}

model ReservationRefund {
  id            String    @id @default(uuid())
  tenantId      String
  soldUnitId    String?
  customerId    String?
  transactionId String?
  amount        Decimal
  amountPaid    Decimal   @default(0)
  status        String    @default("pending") // pending | partial | completed
  payments      String    @default("[]") @db.Text // JSON [{amount, method, paidAt, notes}]
  reason        String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  @@index([tenantId, status])
}

// ─── People ──────────────────────────────────────────────────────────────────

model Customer {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String   @default("")
  email          String?
  phone          String?
  address        String?  @db.Text
  city           String?
  cin            String?
  ice            String?
  notes          String?  @db.Text
  totalPurchases Int      @default(0)
  totalSpent     Decimal  @default(0)
  currentBalance Decimal  @default(0) // amount the customer owes the store
  creditLimit    Decimal?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments CustomerPayment[]

  @@index([tenantId])
}

model CustomerPayment {
  id          String   @id @default(uuid())
  tenantId    String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Decimal
  method      String   @default("cash")
  reference   String?
  notes       String?  @db.Text
  allocations String   @default("[]") @db.Text // JSON [{transactionId, amount}]
  createdBy   String?
  createdAt   DateTime @default(now())
}

model Supplier {
  id             String            @id @default(uuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?           @db.Text
  city           String?
  notes          String?           @db.Text
  totalOrders    Int               @default(0)
  totalPurchased Decimal           @default(0)
  currentBalance Decimal           @default(0) // amount the store owes the supplier
  invoices       SupplierInvoice[]
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId])
}

model SupplierOrder {
  id              String    @id @default(uuid())
  tenantId        String
  storeId         String?
  supplierId      String
  orderNumber     String
  status          String    @default("draft") // draft | pending | partial | received | cancelled
  totalAmount     Decimal   @default(0)
  amountPaid      Decimal   @default(0)
  amountRemaining Decimal   @default(0)
  payments        String    @default("[]") @db.Text // JSON [{amount, method, paidAt, reference}]
  notes           String?   @db.Text
  orderedAt       DateTime  @default(now())
  receivedAt      DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  items SupplierOrderItem[]

  @@index([tenantId])
}

model SupplierOrderItem {
  id               String        @id @default(uuid())
  supplierOrderId  String
  order            SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  itemType         String        @default("product") // product | device
  productId        String?
  productName      String
  sku              String?
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal
  totalCost        Decimal
  deviceType       String?
  brand            String?
  deviceModel      String?
  defaultSalePrice Decimal?
  unitDetails      String?       @db.Text // JSON [{imei, serialNumber, storage, color, condition, salePrice, soldUnitId}]
}

model Employee {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  storeId        String?
  firstName      String
  lastName       String   @default("")
  phone          String?
  role           String   @default("seller")
  commissionRate Decimal?
  isActive       Boolean  @default(true)
  userId         String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── Sales ───────────────────────────────────────────────────────────────────

model Transaction {
  id                    String    @id @default(uuid())
  tenantId              String
  storeId               String?
  cashierId             String?
  employeeId            String?
  customerId            String?
  transactionNumber     String
  type                  String    @default("sale") // sale | return | reservation | trade_in
  status                String    @default("completed") // completed | partial | pending | cancelled | refunded
  subtotal              Decimal   @default(0)
  taxAmount             Decimal   @default(0)
  taxRate               Decimal   @default(0)
  discountAmount        Decimal   @default(0)
  totalAmount           Decimal   @default(0)
  amountPaid            Decimal   @default(0)
  amountRemaining       Decimal   @default(0)
  totalCost             Decimal   @default(0)
  totalProfit           Decimal   @default(0)
  tradeInValue          Decimal   @default(0)
  originalTransactionId String?
  notes                 String?   @db.Text
  cancelReason          String?   @db.Text
  cancelledAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  items    TransactionItem[]
  payments Payment[]

  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
}

model TransactionItem {
  id               String      @id @default(uuid())
  transactionId    String
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId        String?
  soldUnitId       String?
  productName      String
  sku              String?
  quantity         Int
  unitPrice        Decimal
  costPrice        Decimal     @default(0)
  discount         Decimal     @default(0)
  taxAmount        Decimal     @default(0)
  totalPrice       Decimal
  profit           Decimal     @default(0)
  saleMode         String? // unit | pack
  variants         String?     @db.Text // JSON
  returnedQuantity Int         @default(0)
  originalItemId   String?
}

model Payment {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  method        String // cash | card | transfer | cheque | credit
  amount        Decimal
  reference     String?
  receivedAt    DateTime    @default(now())
}

// ─── Cash drawer (caisse) ────────────────────────────────────────────────────

model CaisseMovement {
  id                String   @id @default(uuid())
  tenantId          String
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type              String // cash_in | cash_out | sale | return_refund | reservation_refund | adjustment
  amount            Decimal // positive; signed only for adjustments
  balanceBefore     Decimal
  balanceAfter      Decimal
  reason            String?  @db.Text
  transactionId     String?
  transactionNumber String?
  createdBy         String?
  createdAt         DateTime @default(now())

  @@index([storeId, createdAt])
}

// ─── Invoices ────────────────────────────────────────────────────────────────

model Invoice {
  id              String    @id @default(uuid())
  tenantId        String
  storeId         String?
  invoiceNumber   String
  type            String    @default("transaction") // transaction | standalone
  transactionId   String?
  customerId      String?
  customerName    String?
  customerTaxId   String?
  customerAddress String?   @db.Text
  items           String    @default("[]") @db.Text // JSON [{id, description, quantity, unitPrice, subtotal}]
  subtotal        Decimal   @default(0)
  discountAmount  Decimal   @default(0)
  taxRate         Decimal   @default(0)
  taxAmount       Decimal   @default(0)
  totalAmount     Decimal   @default(0)
  notes           String?   @db.Text
  date            DateTime  @default(now())
  isArchived      Boolean   @default(false)
  archivedAt      DateTime?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, date])
  @@index([transactionId])
}

// ─── Repairs ─────────────────────────────────────────────────────────────────

model Repairer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Repair {
  id                    String    @id @default(uuid())
  tenantId              String
  storeId               String?
  repairNumber          String
  customerId            String?
  deviceDescription     String    @db.Text
  soldUnitId            String?
  repairerId            String?
  diagnosticNotes       String?   @db.Text
  fixedPrice            Decimal?
  totalCost             Decimal   @default(0)
  status                String    @default("pending") // pending | in_progress | completed | delivered | cancelled
  receivedAt            DateTime  @default(now())
  completedAt           DateTime?
  deliveredAt           DateTime?
  transactionId         String?
  createdBy             String?
  notes                 String?   @db.Text
  // Payments collected from the customer (repairs are paid here, never through the POS).
  amountPaid            Decimal   @default(0)
  paymentStatus         String    @default("unpaid") // unpaid | partial | paid
  payments              String    @default("[]") @db.Text // JSON [{id, amount, method, reference?, paidAt, userId}]
  // When the repair became realized income: completed/delivered AND fully paid. Null otherwise.
  realizedAt            DateTime?
  /// Legacy: costs added to the linked stock device's cost instead of the repair (repairs before 2026-10-17 only).
  costsCapitalized      Boolean   @default(false)
  estimatedCompletionAt DateTime?
  trackingToken         String?   @unique // public status link encoded in the repair QR code
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  expenses RepairExpense[]

  @@index([tenantId])
}

model RepairExpense {
  id             String   @id @default(uuid())
  repairId       String
  repair         Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  tenantId       String
  description    String   @db.Text
  amount         Decimal
  type           String   @default("part") // part (bought for the job) | stock_part (taken from inventory) | labor | other
  productId      String? // stock_part: the product taken from stock
  quantity       Int? // stock_part: pieces taken
  unitCost       Decimal? // stock_part: product cost price at the time
  repairerId     String? // labor: the technician paid
  paidFromDrawer Boolean  @default(false) // paid in cash from the drawer
  createdAt      DateTime @default(now())
}

// ─── Labels, announcements, misc ─────────────────────────────────────────────

/// Direct business expenses (rent, salaries, utilities…). Soft-deleted so the history and cash movements stay explainable.
model Expense {
  id            String    @id @default(uuid())
  tenantId      String
  storeId       String?
  title         String
  category      String // rent | salaries | utilities | telecom | transport | supplies | marketing | maintenance | fees | taxes | other
  amount        Decimal
  date          DateTime
  paymentMethod String // cash | card | bank_transfer
  recipient     String?
  notes         String?   @db.Text
  receiptUrl    String?   @db.Text
  receiptName   String?
  clientRef     String? // idempotency key from the entry form
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([tenantId, clientRef])
  @@index([tenantId, date])
}

model LabelTemplate {
  id         String   @id @default(uuid())
  tenantId   String
  categoryId String // product category id, or "__sold_units__" for devices
  brand      String? // device variants only
  deviceType String? // device variants only
  name       String
  template   String   @default("{}") @db.Text // JSON layout + include* flags
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, categoryId])
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  body      String    @db.Text
  type      String    @default("info") // info | warning | success
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PaperOrder {
  id        String   @id @default(uuid())
  tenantId  String
  quantity  Int
  paperType String   @default("caisse") // caisse | produits
  note      String?  @db.Text
  status    String   @default("new") // new | confirmed | shipped | delivered | cancelled
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublicOrder {
  id        String   @id @default(uuid())
  data      String   @db.Text // JSON payload from /commander
  status    String   @default("new")
  createdAt DateTime @default(now())
}

model SubscriptionPlan {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  description   String?  @db.Text
  monthlyPrice  Decimal
  yearlyPrice   Decimal?
  features      String   @default("[]") @db.Text // JSON [{key, label, included}]
  maxStores     Int?
  maxUsers      Int?
  maxProducts   Int?
  maxStockUnits Int?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SubscriptionPayment {
  id          String    @id @default(uuid())
  tenantId    String
  planCode    String
  months      Int       @default(1)
  amount      Decimal
  method      String    @default("bank_transfer")
  status      String    @default("pending") // pending | confirmed | failed
  reference   String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Singleton row (id = "platform") with platform-wide settings managed by the super-admin.
model PlatformSettings {
  id                    String   @id @default("platform")
  paymentGatewayEnabled Boolean  @default(false)
  rib                   String?
  bankName              String?
  accountHolderName     String?
  supportWhatsapp       String?
  trialDays             Int      @default(7)
  updatedAt             DateTime @updatedAt
}

/// One-time data migrations already applied (see src/lib/dataMigrations.ts).
model DataMigration {
  id    String   @id
  ranAt DateTime @default(now())
}

// ─── Supplier invoices ───────────────────────────────────────────────────────

/// A purchase invoice from a supplier. draft: editable, owes nothing · confirmed: owed, payable, receivable · cancelled.
/// Remaining = total − sum of non-voided payments. Stock moves only through per-line received quantities.
model SupplierInvoice {
  id                String    @id @default(uuid())
  tenantId          String
  storeId           String?
  supplierId        String
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  number            String // internal, unique per business (FF-2026-0001)
  supplierRef       String? // the supplier's own invoice number
  supplierOrderId   String? // created from a purchase order: stock is received on the order, its debt moves here
  status            String    @default("draft") // draft | confirmed | cancelled
  invoiceDate       DateTime
  dueDate           DateTime?
  subtotal          Decimal   @default(0)
  discount          Decimal   @default(0)
  taxRate           Decimal   @default(0) // % applied to subtotal − discount
  taxAmount         Decimal   @default(0)
  extraCharges      Decimal   @default(0) // shipping, handling…
  extraChargesLabel String?
  total             Decimal   @default(0)
  amountPaid        Decimal   @default(0)
  notes             String?   @db.Text
  paymentTerms      String?   @db.Text
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?   @db.Text
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  items    SupplierInvoiceItem[]
  payments SupplierPayment[]

  @@unique([tenantId, number])
  @@index([tenantId, supplierId])
  @@index([tenantId, invoiceDate])
}

model SupplierInvoiceItem {
  id               String          @id @default(uuid())
  invoiceId        String
  invoice          SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position         Int             @default(0)
  productId        String? // null = new product, created when the line is first received
  productName      String
  reference        String? // barcode or SKU
  quantity         Int
  quantityReceived Int             @default(0)
  unitCost         Decimal
  lineTotal        Decimal
  newRetailPrice   Decimal? // for a new product
  newCategoryId    String?
}

/// One payment to a supplier. Never deleted: a mistaken payment is voided (cash payments go back into the drawer).
model SupplierPayment {
  id         String           @id @default(uuid())
  tenantId   String
  supplierId String
  invoiceId  String?
  invoice    SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  amount     Decimal
  method     String // cash | card | bank_transfer | check
  paidAt     DateTime
  reference  String?
  notes      String?          @db.Text
  fromOrder  Boolean          @default(false) // carried over from the purchase order (already out of the drawer)
  storeId    String?
  voidedAt   DateTime?
  voidReason String?          @db.Text
  createdBy  String?
  createdAt  DateTime         @default(now())

  @@index([tenantId, supplierId])
  @@index([invoiceId])
}

/// Type Allocation Code (first 8 IMEI digits) → manufacturer / model, used to pre-fill the Add device form.
/// tenantId = a business's own records (learned from the devices it saved; private to it)
/// tenantId = "" = reference data imported from a TAC file (see scripts/import-tac.ts), with its source.
model TacModel {
  id          String   @id @default(uuid())
  tenantId    String   @default("")
  tac         String
  brand       String
  model       String
  modelNumber String?
  aliases     String?  @db.Text // other names for this TAC in the source ("aka"), comma-separated
  deviceType  String?
  source      String // "own" or the imported file's source / licence
  seenCount   Int      @default(1)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([tenantId, tac])
  @@index([tac])
}

/// A retail box barcode (EAN / UPC) of a phone model, learned from devices this business added with it.
/// Private to the business. A box barcode identifies a model (often with storage / colour), never an individual phone.
model ModelBarcode {
  id         String   @id @default(uuid())
  tenantId   String
  code       String
  deviceType String   @default("phone")
  brand      String
  model      String
  storage    String?
  color      String?
  seenCount  Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, code])
}

/// Phone scanners. A computer (browser) that receives scans registers as a ScannerScreen; a phone is authorized once
/// with a one-time QR code (ScannerPairing) and becomes a ScannerDevice holding a long-lived random secret, of which
/// only the hash is stored. The device sends its scans to the screen it chose (screenId).
model ScannerScreen {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String // last user signed in on it
  name       String
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model ScannerDevice {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String // who authorized it; the device stops working if that user is deactivated
  name       String
  tokenHash  String    @unique
  screenId   String? // where its scans go
  userAgent  String?   @db.Text
  scanCount  Int       @default(0)
  lastSeenAt DateTime?
  expiresAt  DateTime // moves forward each time the phone is used
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

/// One-time QR code to authorize a phone (10 minutes, used once).
model ScannerPairing {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String
  screenId  String?
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  deviceId  String?
  createdAt DateTime  @default(now())

  @@index([tenantId])
}

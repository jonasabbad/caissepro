{
  "name": "caissepro",
  "private": true,
  "version": "0.1.0",
  "description": "CaissePro: point-of-sale and store management for phone shops",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "setup": "npm install && npm run db:init -w server",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev -w server\" \"npm:dev -w web\"",
    "dev:phone": "concurrently -n api,web -c blue,green \"npm:dev -w server\" \"npm:dev:phone -w web\"",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "db:reset": "npm run db:reset -w server",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
